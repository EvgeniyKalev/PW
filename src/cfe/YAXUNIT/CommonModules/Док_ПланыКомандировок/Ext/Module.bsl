Функция СозданиеСотрудника(Наименование)
	
	// Создание товара с видом Товар
	//ТоварНовый = ЮТест.Данные().СоздатьЭлемент("Справочники.Товары");   - не подойдет, т.к. не можем отрегулировать вид товара
		
	КонструкторСотрудника = ЮТест.Данные().КонструкторОбъекта("Справочники.ФизическиеЛица")
		.ФикцияОбязательныхПолей()
		.Установить("Наименование", Наименование)
		;
	СотрудникНовый = КонструкторСотрудника.Записать();
	
	Возврат СотрудникНовый;

КонецФункции

